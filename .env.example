# TaskFlow Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual settings.
# WARNING: NEVER commit your real .env file or credentials to Git.

# Application Server Port (default: 3000)
PORT=3000

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (Optional, defaults to database specified in URI or "taskflow")
MONGODB_DATABASE=taskflow
